<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Poner delante la ventana de la parte elegida del PAP (permiso normal). -->
    <uses-permission android:name="android.permission.REORDER_TASKS" />
    <!-- Para volver a encender el servicio de la tuerca tras cada actualización (Android lo apaga).
         Se concede una vez por adb: pm grant com.chaska.inicio android.permission.WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lista de canales de la TDT para la ventanita (permiso normal: no hay que concederlo). -->
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <!-- Para leer fondos de /sdcard/Fondos, Descargas y USB. Se concede por adb (ver README). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Android 11+: para poder ver las apps instaladas y abrirlas. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Para saber si el inicio de Google está desactivado (interruptor «Launcher por defecto»). -->
        <package android:name="com.google.android.tvlauncher" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tecla de ajustes del mando (ver Teclas.kt). Se activa por adb. -->
        <service
            android:name=".Teclas"
            android:exported="true"
            android:label="Stark TV · tecla de ajustes"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/teclas" />
        </service>

        <!-- Selector del PAP (recuadro sobre la parte activa). Tarea propia, por encima de las dos partes. -->
        <activity
            android:name=".pap.SelectorPap"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="com.chaska.inicio.selector"
            android:theme="@style/Tema.Transparente" />

        <!-- Fondo negro del PAP, a pantalla completa debajo de las dos partes. -->
        <activity
            android:name=".pap.FondoPap"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.chaska.inicio.papfondo" />

        <!-- Visores de TV del PAP: uno por mitad, cada uno en su tarea para poder estar a la vez. -->
        <activity
            android:name=".pap.VisorIzq"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.chaska.inicio.pap1" />
        <activity
            android:name=".pap.VisorDer"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="com.chaska.inicio.pap2" />
    </application>
</manifest>
